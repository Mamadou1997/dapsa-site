# Dépendances installées par Composer (reconstruites avec « composer install »)
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/

# Fichiers propres à chaque serveur : jamais dans Git
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/files/
/web/sites/*/private/
/web/sites/simpletest/

# Sauvegardes et bases de données
*.sql
*.sql.gz
*.tar.gz
*.zip

# Fichiers d'éditeurs et système
.DS_Store
.idea/
.vscode/
